# Run npm run setup to create .env with fresh random secrets and mode 0600.
# Empty values intentionally fail Compose validation; there are no demo passwords.
COMPOSE_PROJECT_NAME=jackpot-reference
GATEWAY_PORT=3000
JWT_SECRET=
INTERNAL_TOKEN=
POSTGRES_PASSWORD=
AUTH_DB_PASSWORD=
USERS_DB_PASSWORD=
BETS_DB_PASSWORD=
JACKPOT_DB_PASSWORD=
BROKER_PASSWORD=
DEMO_ADMIN_EMAIL=admin@example.invalid
DEMO_ADMIN_PASSWORD=
# Optional: set to http://jaeger:4318, then docker compose --profile tracing up -d
OTEL_EXPORTER_OTLP_ENDPOINT=
